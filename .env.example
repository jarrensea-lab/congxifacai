# DeepSeek API 配置
DEEPSEEK_API_KEY=

# Qwen (通义千问) API 配置 — 多模型多样性（裁判用）
# 获取方式: https://bailian.console.aliyun.com/ → API-KEY 管理
QWEN_API_KEY=

# Tushare 数据源
TUSHARE_TOKEN=
CONGXI_TUSHARE_NEWS_ROOT=/Users/zhuchenyuan/AI/projects/司库/01-资料采集/量化投资/Serenity研究/数据采集/tushare-news

# 飞书机器人
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_ONLY=true

# 报告归档
CONGXI_REPORT_ARCHIVE_DIR=/Users/zhuchenyuan/AI/projects/司库/01-资料采集/量化投资/恭喜发财报告

# 投资策略模式: capital_preservation / growth_sprint
CONGXI_STRATEGY_MODE=growth_sprint

# 飞书多维表格配置 — 6张维度的table_id
# 当前默认只走 Webhook，以下 API 通道暂不启用。
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_STRATEGY=
FEISHU_TABLE_STOCK_POOL=
FEISHU_TABLE_POSITIONS=
FEISHU_TABLE_INDICES=
FEISHU_TABLE_RISK=
FEISHU_TABLE_PERFORMANCE=

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FRONTEND_PORT=3000

# 运行时数据库（默认放在本机磁盘，避免外置盘中断常驻服务）
CONGXI_STATE_DIR=/Users/zhuchenyuan/Library/Application Support/congxicai-v7
# 以下两项通常留空，仅在需要分别覆盖业务库/调度库路径时设置
CONGXI_DATABASE_PATH=
CONGXI_SCHEDULER_DATABASE_PATH=

# 广发易淘金 Mac 安全桥（默认完全关闭）
# 只开启第一个开关：允许只读账户/自选/有限行情校验。
# 第二个开关同时开启后：允许把账户真值写回本项目，并受控更新自选股；仍不支持交易。
CONGXI_YITAOJIN_ENABLED=false
CONGXI_YITAOJIN_WRITE_ENABLED=false
CONGXI_YITAOJIN_ACCOUNT_WRITE_ENABLED=false
CONGXI_YITAOJIN_WATCHLIST_WRITE_ENABLED=false
CONGXI_YITAOJIN_APP_PATH=/Applications/GF-Trader.app
CONGXI_YITAOJIN_BRIDGE_PATH=/Users/zhuchenyuan/Library/Application Support/congxicai-v7/bin/yitaojin-bridge
CONGXI_YITAOJIN_TASK_TIMEOUT_SECONDS=120
CONGXI_YITAOJIN_APP_START_TIMEOUT_SECONDS=30
# 以下运行状态默认位于 CONGXI_STATE_DIR/yitaojin；仅测试或迁移时覆盖
CONGXI_YITAOJIN_ACCOUNT_SNAPSHOT_PATH=
CONGXI_YITAOJIN_ACCOUNT_FINGERPRINT_SALT_PATH=
CONGXI_YITAOJIN_ACCOUNT_AUDIT_PATH=
CONGXI_YITAOJIN_WATCHLIST_STATE_PATH=
CONGXI_YITAOJIN_WATCHLIST_AUDIT_PATH=
CONGXI_YITAOJIN_QUOTE_SNAPSHOT_PATH=
CONGXI_YITAOJIN_RUNTIME_STATUS_PATH=
